@model IEnumerable<EventBaseSystem.Models.booking>

@{
    ViewData["Title"] = "Booking Page";
}

<h1>Index</h1>

<!-- Search form -->
<form asp-action="Index" method="get">
    <div class="form-group">
        <input type="text" name="searchString" class="form-control" placeholder="Search bookings..." />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Search</button>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>BookingID</th>
            <th>Event Name</th>
            <th>Venue</th>
            <th>Booking Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.BookingID</td>
                <td>@booking.Event?.EventName</td> <!-- Display actual event name -->
                <td>@booking.Venue?.Name</td> <!-- Display actual venue name -->
                <td>@booking.StartDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@booking.BookingID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@booking.BookingID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@booking.BookingID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>